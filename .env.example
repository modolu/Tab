# Browser build configuration. Set VITE_CONVEX_URL to the intended Convex deployment.
VITE_CONVEX_URL=
# Optional local convenience only. Tab derives share links from window.location.origin.
VITE_APP_URL=http://localhost:5173

# Convex deployment configuration. Set these with `npx convex env set`; do not expose
# RPC credentials through VITE_* variables or commit their values.
# Development/testnet:
NIMIQ_NETWORK=testnet
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
# Production/mainnet:
# NIMIQ_NETWORK=mainnet
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMIQ_RPC_USERNAME=
NIMIQ_RPC_PASSWORD=

# Development-only read-only verifier diagnostics. Keep false/absent in production.
NIMIQ_ENABLE_DEV_DIAGNOSTICS=false
